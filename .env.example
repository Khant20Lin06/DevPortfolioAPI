PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myportfolio"

FRONTEND_ORIGIN=http://localhost:3000
STAGING_FRONTEND_ORIGIN=
FRONTEND_ORIGINS=

FEATURE_AUTH_ENABLED=true

JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN_HOURS=24
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-admin-password

UPLOAD_DIR=uploads
STORAGE_DRIVER=local
# Cloudflare R2 / S3-compatible storage example:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=myportfolio-assets
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_PUBLIC_BASE_URL=https://<PUBLIC_BUCKET_DOMAIN>
# S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_SUBJECT=
